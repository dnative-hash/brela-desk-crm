# Copy to .env for local use (npm run dev). On Railway, set these in the Variables tab.
DATABASE_URL=postgres://user:password@localhost:5432/brela
JWT_SECRET=change-me-long-random-string
# 64 hex characters (32 bytes). Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Created only on first start, when there are no users yet
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
PORT=3000

# ---- WhatsApp (optional; leave empty to keep it switched off) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Reply "Document received" to clients automatically (true/false)
WA_AUTOREPLY=false
DEFAULT_COUNTRY_CODE=255
DIGEST_HOUR=7

# ---- Lock screen image and daily quotes (optional) ----
PIXABAY_API_KEY=
API_NINJAS_API_KEY=
